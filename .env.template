# Security Configuration Template
# Copy this to .env and fill in your actual passwords

# IMPORTANT: Change all passwords before deployment!
# Use strong, unique passwords for each environment

# MongoDB Passwords (CHANGE THESE!)
MONGO_ROOT_PASSWORD=your_secure_root_password_here
MONGO_STAGING_PASSWORD=your_secure_staging_password_here  
MONGO_PRODUCTION_PASSWORD=your_secure_production_password_here

# Database Connection Strings
# These will use the passwords above
STAGING_DATABASE_URL=mongodb://admin:${MONGO_STAGING_PASSWORD}@localhost:27017/fyp_staging
PRODUCTION_DATABASE_URL=mongodb://admin:${MONGO_PRODUCTION_PASSWORD}@localhost:27017/fyp_production

# GitHub Secrets to Set (when ready for Azure deployment):
# 1. AZURE_CREDENTIALS (generated by setup script)
# 2. AZURE_RESOURCE_GROUP (generated by setup script)  
# 3. AZURE_REGISTRY_USERNAME (generated by setup script)
# 4. AZURE_REGISTRY_PASSWORD (generated by setup script)
# 5. STAGING_DATABASE_URL (use the staging URL above with your password)
# 6. PRODUCTION_DATABASE_URL (use the production URL above with your password)

# Security Notes:
# - Never commit .env files to Git
# - Use different passwords for staging vs production
# - Use strong passwords (minimum 16 characters)
# - Include numbers, letters, and special characters
# - Consider using a password manager to generate secure passwords