{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Azure Container Instances for FYP Stock Analyzer Application",
    "author": "GitHub Copilot CI/CD Setup"
  },
  "parameters": {
    "containerGroupName": {
      "type": "string",
      "defaultValue": "fyp-stock-analyzer",
      "metadata": {
        "description": "Name of the container group"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "backendImage": {
      "type": "string",
      "metadata": {
        "description": "Backend container image from ACR"
      }
    },
    "frontendImage": {
      "type": "string",
      "metadata": {
        "description": "Frontend container image from ACR"
      }
    },
    "registryServer": {
      "type": "string",
      "metadata": {
        "description": "Azure Container Registry login server"
      }
    },
    "registryUsername": {
      "type": "string",
      "metadata": {
        "description": "Azure Container Registry username"
      }
    },
    "registryPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Azure Container Registry password"
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "staging",
      "allowedValues": [
        "staging",
        "production"
      ],
      "metadata": {
        "description": "Deployment environment"
      }
    },
    "databaseUrl": {
      "type": "securestring",
      "metadata": {
        "description": "MongoDB connection string"
      }
    },
    "mongoPassword": {
      "type": "securestring",
      "metadata": {
        "description": "MongoDB root password"
      }
    }
  },
  "variables": {
    "containerGroupName": "[concat(parameters('containerGroupName'), '-', parameters('environment'))]",
    "backendContainerName": "backend",
    "frontendContainerName": "frontend",
    "mongoContainerName": "mongodb",
    "ollamaContainerName": "ollama",
    "dnsNameLabel": "[concat('fyp-', parameters('environment'), '-', uniqueString(resourceGroup().id))]"
  },
  "resources": [
    {
      "type": "Microsoft.ContainerInstance/containerGroups",
      "apiVersion": "2018-06-01",
      "name": "[variables('containerGroupName')]",
      "location": "[parameters('location')]",
      "properties": {
        "containers": [
          {
            "name": "[variables('backendContainerName')]",
            "properties": {
              "image": "[parameters('backendImage')]",
              "ports": [
                {
                  "port": 8000,
                  "protocol": "TCP"
                }
              ],
              "environmentVariables": [
                {
                  "name": "DATABASE_URL",
                  "secureValue": "[parameters('databaseUrl')]"
                },
                {
                  "name": "NODE_ENV",
                  "value": "[parameters('environment')]"
                },
                {
                  "name": "OLLAMA_BASE_URL",
                  "value": "http://localhost:11434"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": "[if(equals(parameters('environment'), 'production'), 2, 1)]",
                  "memoryInGB": "[if(equals(parameters('environment'), 'production'), 4, 2)]"
                }
              },
              "livenessProbe": {
                "httpGet": {
                  "path": "/",
                  "port": 8000
                },
                "initialDelaySeconds": 30,
                "periodSeconds": 10
              }
            }
          },
          {
            "name": "[variables('frontendContainerName')]",
            "properties": {
              "image": "[parameters('frontendImage')]",
              "ports": [
                {
                  "port": 80,
                  "protocol": "TCP"
                }
              ],
              "environmentVariables": [
                {
                  "name": "REACT_APP_API_URL",
                  "value": "[concat('http://', variables('dnsNameLabel'), '.', parameters('location'), '.azurecontainer.io:8000')]"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": 0.5,
                  "memoryInGB": 1
                }
              }
            }
          },
          {
            "name": "[variables('mongoContainerName')]",
            "properties": {
              "image": "mongo:7-jammy",
              "ports": [
                {
                  "port": 27017,
                  "protocol": "TCP"
                }
              ],
              "environmentVariables": [
                {
                  "name": "MONGO_INITDB_ROOT_USERNAME",
                  "value": "admin"
                },
                {
                  "name": "MONGO_INITDB_ROOT_PASSWORD",
                  "secureValue": "[parameters('mongoPassword')]"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": 0.5,
                  "memoryInGB": 1
                }
              },
              "volumeMounts": [
                {
                  "name": "mongodb-data",
                  "mountPath": "/data/db"
                }
              ]
            }
          },
          {
            "name": "[variables('ollamaContainerName')]",
            "properties": {
              "image": "ollama/ollama:latest",
              "ports": [
                {
                  "port": 11434,
                  "protocol": "TCP"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": 1,
                  "memoryInGB": 2
                }
              }
            }
          }
        ],
        "osType": "Linux",
        "restartPolicy": "OnFailure",
        "ipAddress": {
          "type": "Public",
          "ports": [
            {
              "port": 8000,
              "protocol": "TCP"
            },
            {
              "port": 80,
              "protocol": "TCP"
            }
          ],
          "dnsNameLabel": "[variables('dnsNameLabel')]"
        },
        "imageRegistryCredentials": [
          {
            "server": "[parameters('registryServer')]",
            "username": "[parameters('registryUsername')]",
            "password": "[parameters('registryPassword')]"
          }
        ],
        "volumes": [
          {
            "name": "mongodb-data",
            "emptyDir": {}
          }
        ]
      }
    }
  ],
  "outputs": {
    "containerGroupName": {
      "type": "string",
      "value": "[variables('containerGroupName')]"
    },
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerInstance/containerGroups', variables('containerGroupName'))).ipAddress.fqdn]"
    },
    "backendUrl": {
      "type": "string",
      "value": "[concat('http://', reference(resourceId('Microsoft.ContainerInstance/containerGroups', variables('containerGroupName'))).ipAddress.fqdn, ':8000')]"
    },
    "frontendUrl": {
      "type": "string",
      "value": "[concat('http://', reference(resourceId('Microsoft.ContainerInstance/containerGroups', variables('containerGroupName'))).ipAddress.fqdn)]"
    }
  }
}